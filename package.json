{
  "name": "9router-provider-bridge",
  "displayName": "9Router Provider Bridge",
  "description": "Brings 9Router providers, combos and account pools into VS Code Copilot's model picker",
  "version": "0.1.0",
  "publisher": "n0safe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/N0SAFE/9router-provider-bridge"
  },
  "bugs": {
    "url": "https://github.com/N0SAFE/9router-provider-bridge/issues"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.120.0"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "9router",
    "router",
    "copilot",
    "byok",
    "llm",
    "provider",
    "ai"
  ],
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "pricing": "Free",
  "activationEvents": [
    "onStartupFinished"
  ],
  "enabledApiProposals": [
    "chatSessionsProvider"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "configuration": {
      "title": "9Router Provider Bridge",
      "properties": {
        "9router-provider-bridge.logLevel": {
          "type": "string",
          "default": "info",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "enumDescriptions": [
            "Only errors",
            "Errors and warnings",
            "Errors, warnings, and info messages",
            "Everything including verbose debug messages"
          ],
          "description": "Log verbosity level for the 9Router Bridge output panel."
        },
        "9router-provider-bridge.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:20128/v1",
          "description": "Default 9Router base URL. Used when a chatLanguageModels.json group does not set its own baseUrl."
        },
        "9router-provider-bridge.remoteSessionModel": {
          "type": "string",
          "default": "",
          "description": "Model or combo used by new 9Router cloud agent sessions (e.g. free or ocg/deepseek-flash). Empty picks the first catalog entry (combos first)."
        }
      }
    },
    "chatSessions": [
      {
        "type": "9router",
        "name": "9router",
        "displayName": "9Router Cloud",
        "description": "Agent sessions running on your 9Router host with workspace copies and 9Router models"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "9router-provider-bridge",
        "displayName": "9Router",
        "configuration": {
          "properties": {
            "apiKey": {
              "type": "string",
              "secret": true,
              "description": "Optional 9Router API key. Leave empty for a local instance with requireApiKey disabled.",
              "defaultSnippets": [
                {
                  "body": "sk-..."
                }
              ]
            },
            "baseUrl": {
              "type": "string",
              "default": "http://127.0.0.1:20128/v1",
              "description": "9Router base URL (OpenAI-compatible root, usually ending in /v1).",
              "defaultSnippets": [
                {
                  "body": "http://127.0.0.1:20128/v1"
                }
              ]
            },
            "mode": {
              "type": "string",
              "enum": [
                "all",
                "providers",
                "combos",
                "pools"
              ],
              "default": "all",
              "enumDescriptions": [
                "Provider models and combos",
                "Provider models grouped by active provider only",
                "Combos only",
                "Account pool status (display only, not selectable)"
              ],
              "description": "What this group exposes in the model picker. Create several groups (with different names) to get one entry for providers, one for combos and one for pools."
            },
            "providers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Optional provider filter: expose only models from these provider aliases (e.g. oc, ocg, ollama). Leave empty for all active providers. Configure with \"9Router Bridge: Configure Provider\"."
            },
            "models": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Optional model filter: expose only these model ids (e.g. ocg/kimi-k2.7-code or a combo name). Leave empty for every discovered model. Configure with \"9Router Bridge: Configure Provider\"."
            }
          }
        }
      }
    ],
    "commands": [
      {
        "command": "9router-provider-bridge.refreshModels",
        "title": "9Router Bridge: Refresh Models"
      },
      {
        "command": "9router-provider-bridge.showStatus",
        "title": "9Router Bridge: Show Status"
      },
      {
        "command": "9router-provider-bridge.showPools",
        "title": "9Router Bridge: Show Pools"
      },
      {
        "command": "9router-provider-bridge.configureProvider",
        "title": "9Router Bridge: Configure Provider"
      },
      {
        "command": "9router-provider-bridge.remoteStatus",
        "title": "9Router Bridge: Remote Agent Status"
      },
      {
        "command": "9router-provider-bridge.remoteStart",
        "title": "9Router Bridge: Start Remote Agent"
      },
      {
        "command": "9router-provider-bridge.remoteStop",
        "title": "9Router Bridge: Stop Remote Agent"
      },
      {
        "command": "9router-provider-bridge.remoteLogs",
        "title": "9Router Bridge: Show Remote Agent Logs"
      },
      {
        "command": "9router-provider-bridge.addRemoteProvider",
        "title": "9Router Bridge: Add Remote Provider"
      }
    ]
  },
  "scripts": {
    "clean": "rimraf dist",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:esbuild": "node esbuild.js --watch",
    "watch": "npm run clean && npm-run-all -p watch:*",
    "test": "rimraf .test-dist && npx --no-install tsc --outDir .test-dist --rootDir src && node --test .test-dist/*.test.js",
    "vscode:prepublish": "npm run package",
    "compile": "npm run clean && npm run check-types && npm run lint && node esbuild.js",
    "package": "npm run clean && npm run check-types && npm run lint && node esbuild.js --production",
    "install:local": "node scripts/install-local.mjs",
    "uninstall": "code-insiders --uninstall-extension n0safe.9router-provider-bridge",
    "uninstall:local": "code-insiders --uninstall-extension n0safe.9router-provider-bridge-local"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.47",
    "ai": "^6.0.180"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^2.10.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
